{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuanshiai.local/schemas/ai-evidence-v1.schema.json",
  "title": "Xuanshi AI evidence artifact v1",
  "description": "Commit-bound release, rollback, and stability evidence. Structural validity does not imply a GO decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "target",
    "branch",
    "commit_sha",
    "dirty",
    "environment",
    "generated_at",
    "policy_version",
    "provider",
    "model",
    "schema_versions",
    "commands",
    "exit_codes",
    "input_artifact_hashes",
    "output_artifact_hashes",
    "reviewer",
    "gates",
    "blockers",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-evidence-v1"
    },
    "artifact_type": {
      "enum": [
        "command-bundle",
        "readiness",
        "rollback",
        "stability"
      ]
    },
    "target": {
      "enum": [
        "internal",
        "production"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "environment": {
      "enum": [
        "development",
        "testing",
        "staging",
        "production"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "schema_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandEvidence"
      }
    },
    "exit_codes": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "input_artifact_hashes": {
      "$ref": "#/$defs/hashMap"
    },
    "output_artifact_hashes": {
      "$ref": "#/$defs/hashMap"
    },
    "reviewer": {
      "$ref": "#/$defs/reviewer"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7"
      ],
      "properties": {
        "G0": {
          "$ref": "#/$defs/gateEvidence"
        },
        "G1": {
          "$ref": "#/$defs/gateEvidence"
        },
        "G2": {
          "$ref": "#/$defs/gateEvidence"
        },
        "G3": {
          "$ref": "#/$defs/gateEvidence"
        },
        "G4": {
          "$ref": "#/$defs/gateEvidence"
        },
        "G5": {
          "$ref": "#/$defs/gateEvidence"
        },
        "G6": {
          "$ref": "#/$defs/gateEvidence"
        },
        "G7": {
          "$ref": "#/$defs/gateEvidence"
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "release_gate": {
      "enum": [
        "passed",
        "disabled-until-approved"
      ]
    },
    "decision_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "config": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "details": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "CONDITIONAL",
        "NOT_RUN",
        "NO-GO"
      ]
    },
    "hashMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 500
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "status": {
          "enum": [
            "REVIEWED",
            "PENDING",
            "NOT_RUN"
          ]
        }
      }
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gate",
        "evidence_kind",
        "command",
        "argv",
        "started_at",
        "finished_at",
        "exit_code",
        "stdout_path",
        "stdout_sha256",
        "stderr_path",
        "stderr_sha256",
        "result_file",
        "result_file_sha256",
        "input_hashes",
        "output_hashes",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "gate": {
          "enum": [
            "G0",
            "G1",
            "G2",
            "G3",
            "G4",
            "G5",
            "G6",
            "G7"
          ]
        },
        "evidence_kind": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "result_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_hashes": {
          "$ref": "#/$defs/hashMap"
        },
        "output_hashes": {
          "$ref": "#/$defs/hashMap"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command_ids"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/result"
        },
        "command_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
