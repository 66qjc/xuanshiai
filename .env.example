# ==================== 应用基础配置 ====================
# 应用名称，会显示在 OpenAPI 文档和根路径响应中。
APP_NAME=Xuanshi AI API
# 当前版本号，发布时请同步修改。
APP_VERSION=0.1.0
# 可选值：development、testing、staging、production。
ENVIRONMENT=development
# 开发环境开启调试；生产环境必须改为 false。
DEBUG=true
# 是否暴露 /docs 和 /redoc；生产环境可按安全策略关闭。
DOCS_ENABLED=true
# 监听地址。容器部署通常使用 0.0.0.0，本机开发使用 127.0.0.1。
HOST=127.0.0.1
# FastAPI/Uvicorn 服务端口。
PORT=8000
# API 统一前缀，后续业务接口都挂在该路径下。
API_PREFIX=/api/v1
# 开发/测试环境启动时自动创建数据库和表；staging/production 必须设为 false。
AUTO_INIT_DB=true

# ==================== 数据库与缓存 ====================
# MySQL 异步连接串；请替换用户名、密码、主机、端口和数据库名。
DATABASE_URL=mysql+aiomysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/xuanshiai
# Redis 连接串；用于缓存、限流、验证码和异步任务状态等。
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== 登录与安全 ====================
# JWT 签名密钥；生产环境必须使用高强度随机字符串，禁止提交真实密钥。
SECRET_KEY=change-me-in-local-env
# JWT 签名算法。
JWT_ALGORITHM=HS256
# 访问令牌有效期，单位为分钟。
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh Token 有效期和单账号最多有效设备数。
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_SESSIONS_PER_USER=5
# 验证码策略；短信服务接入后将 SMS_PROVIDER 替换为实际适配器名称。
SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT=10
# 可选值：disabled、mock；真实供应商适配器接入后再填写对应名称。
SMS_PROVIDER=disabled
# 仅 development/testing 环境可使用 mock，固定测试验证码为123456。
SMS_MOCK_CODE=123456
# 微信小程序配置，接入微信登录前必须填写真实值。
WECHAT_PROVIDER=wechat
WECHAT_APP_ID=YOUR_WECHAT_APP_ID
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET
# 微信支付模式：mock 仅用于 development/testing；real 使用真实微信支付回调。
WECHAT_PAYMENT_MODE=mock
# Mock 微信凭证格式为 mock-code-001，仅允许 development/testing 环境。
WECHAT_MOCK_OPENID_PREFIX=mock-openid-
# 当前发布的协议版本，格式为 agreement_type:version，多个用逗号分隔。
AGREEMENT_VERSIONS_RAW=user_service:v1,privacy_policy:v1,safety_pledge:v1,community_rules:v1

# ==================== 跨域、文件与日志 ====================
# 多个来源使用英文逗号分隔，不要在生产环境使用 *。
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:5173
# 用户上传文件的本地存储目录；生产环境可替换为对象存储挂载目录。
UPLOAD_DIR=storage/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
WECHAT_MINI_PROGRAM_PAGE=pages/profile/profile

# Discovery quotas. Keep these values server-side; do not accept them from clients.
RECOMMENDATION_PAGE_SIZE=20
BROWSE_DAILY_LIMIT=8
BROWSE_HIGH_MATCH_BONUS=5
APPLY_DAILY_FREE_LIMIT=3
APPLY_DAILY_VIP_LIMIT=10
SUPERLIKE_DAILY_FREE_LIMIT=1
SUPERLIKE_DAILY_VIP_LIMIT=3
PAPER_PLANE_DAILY_LIMIT=3
# 阿里云云市场敏感词二次审核。默认关闭，配置真实接口信息后再启用。
ALIYUN_CONTENT_MODERATION_ENABLED=false
ALIYUN_CONTENT_MODERATION_BASE_URL=https://lxmingan.market.alicloudapi.com
ALIYUN_CONTENT_MODERATION_PATH=/YOUR_API_PATH
ALIYUN_CONTENT_MODERATION_APP_CODE=YOUR_ALIYUN_MARKET_APPCODE
# 云市场接口文档要求 JSON 时使用 json，要求表单时使用 form。
ALIYUN_CONTENT_MODERATION_REQUEST_MODE=json
ALIYUN_CONTENT_MODERATION_TEXT_FIELD=text
ALIYUN_CONTENT_MODERATION_TIMEOUT_SECONDS=2.5
# 阿里云不可用时：review 进入人工审核，reject 直接拒绝。
ALIYUN_CONTENT_MODERATION_FAIL_MODE=review
# 阿里云命中但未返回明确业务动作时的默认动作。
ALIYUN_CONTENT_MODERATION_DEFAULT_ACTION=manual_review
# 牵线服务首次创建次数账户时的默认次数；正式规则应改为配置中心或后台规则。
COMMUNITY_CITY_COOLDOWN_DAYS=7
MATCHMAKER_SERVICE_DEFAULT_QUOTA=0

# ==================== 会员价格与积分配置 ====================
# 会员价格覆盖数据库套餐配置，单位为元；未设置时使用数据库值。
# MEMBERSHIP_MONTHLY_PRICE=99
# MEMBERSHIP_QUARTERLY_PRICE=269
# MEMBERSHIP_YEARLY_PRICE=899
# MEMBERSHIP_MONTHLY_ORIGINAL_PRICE=129
# MEMBERSHIP_QUARTERLY_ORIGINAL_PRICE=329
# MEMBERSHIP_YEARLY_ORIGINAL_PRICE=1099
# MEMBERSHIP_MONTHLY_DAILY_PRICE=3.30
# MEMBERSHIP_QUARTERLY_DAILY_PRICE=2.99
# MEMBERSHIP_YEARLY_DAILY_PRICE=2.46

# 积分奖励配置，单位为分。
POINT_CHECKIN_REWARD=5
POINT_PROFILE_COMPLETE_REWARD=50
POINT_REALNAME_VERIFIED_REWARD=100

# 积分商品每次消耗配置，设置后覆盖 config_point_product.points_cost。
# 商品名称、库存、上下架和权益内容仍由数据库配置。
# POINT_COST_EXTRA_APPLY=20
# POINT_COST_EXTRA_SUPERLIKE=50
# POINT_COST_BROWSE_UNLOCK=10
# POINT_COST_EXPOSURE_CARD=100
# POINT_COST_PAPER_PLANE_UNLOCK=30
# POINT_COST_PROFILE_DETAIL_UNLOCK=10
# POINT_COST_MEMBERSHIP_EXCHANGE=1000
# POINT_COST_SERVICE_COUPON=500

# ==================== Testing and integration (testing only) ====================
# Database-backed tests require ENVIRONMENT=testing. Never use a test database in production.
# COMMUNITY_TEST_DATABASE_URL=mysql+aiomysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/xuanshiai_test
# Base URL for live HTTP integration tests; unset tests are skipped.
# LIVE_API_BASE=http://127.0.0.1:8000/api/v1
# 日志级别，可选 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# ==================== AI 画像 / 搜索 / 匹配度 ====================
# 一期全部默认关闭。生产环境启用任何 AI 开关前，必须同时满足
# AI_POLICY_APPROVED=true、AI_PROVIDER_APPROVED=true、AI_RETENTION_POLICY_VERSION
# 非空，且 AI_PROVIDER 不是 mock；否则 Settings 校验失败并对外保持
# HTTP 503 AI_FEATURE_DISABLED（retryable=false）。
AI_MASTER_ENABLED=false
AI_PROFILE_ENABLED=false
AI_SEARCH_ENABLED=false
AI_COMPATIBILITY_SHADOW_ENABLED=false
# 一期默认 mock；真 provider 可选 deepseek / dots。生产环境启用 AI 时
# 禁止使用 mock。
AI_PROVIDER=mock
# 生产启用门禁（未批准时保持 false/空）。
AI_POLICY_APPROVED=false
AI_PROVIDER_APPROVED=false
AI_RETENTION_POLICY_VERSION=
# DeepSeek provider（OpenAI 兼容 API）。真实 api_key 仅存于被忽略的 .env，
# 此处只放占位符。deepseek-chat 已弃用，由 deepseek-v4-flash 接替。
AI_DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-v4-flash
AI_DEEPSEEK_MAX_TOKENS=2048
# Dots provider（小红书 hi lab dots.llm，OpenAI 兼容 API）。真实 api_key 仅存于
# 被忽略的 .env，此处只放占位符。dots3-note-prev 为推理模型，max_tokens 需覆盖
# 推理消耗，默认 4096。
AI_DOTS_API_KEY=YOUR_DOTS_API_KEY
AI_DOTS_BASE_URL=https://note3-prev-api.askdiandian.com/v1
AI_DOTS_MODEL=dots3-note-prev
AI_DOTS_MAX_TOKENS=4096
# Narrative 专用模型覆盖（可选）。画像叙事层 generate_narrative 是重推理任务，
# 默认走主 provider 的模型。若主 provider 是推理模型（如 dots3-note-prev），生成
# 耗时可达数十秒；通过此项指定一个更快的非推理模型 + 配套 provider 单独驱动
# narrative，其余方法（抽取/搜索/回复）不受影响。留空则回退到主 provider。
AI_NARRATIVE_PROVIDER=
AI_NARRATIVE_MODEL=
AI_NARRATIVE_MAX_TOKENS=0
# AI 任务/租约/重试/限流配置。
AI_LEASE_SECONDS=300
AI_MAX_ATTEMPTS=3
AI_SEARCH_PARSE_RATE_PER_MINUTE=5
AI_PROFILE_SESSION_EXPIRE_DAYS=7
AI_SEARCH_DRAFT_EXPIRE_HOURS=24
AI_COMPATIBILITY_SNAPSHOT_TTL_MINUTES=10
AI_GATEWAY_TIMEOUT_SECONDS=30.0

# ==================== 语音（STT/TTS）P-04 / Phase 4 ====================
# 默认关闭。生产启用需满足三道审批门禁 + AccessKey 配置；
# 还须完成阿里云 DPA / 数据出境审查。
AI_VOICE_ENABLED=false
AI_VOICE_PROVIDER=aliyun
#   AI_ALIYUN_VOICE_API_KEY=<your_key>
#   AI_ALIYUN_VOICE_APP_KEY=<your_app_key>
AI_ALIYUN_VOICE_REGION=cn-shanghai
AI_ALIYUN_VOICE_ASR_MODEL=paraformer-realtime-v2
AI_ALIYUN_VOICE_TTS_MODEL=cosyvoice-v1
AI_TTS_MAX_TEXT_LENGTH=500
AI_ASR_MAX_DURATION_SECONDS=60
AI_VOICE_AUDIO_RETENTION_HOURS=24
# ==================== 实时半双工语音对话（P-04b）====================
# 后端调阿里云 NLS 实时 ASR 边说边出字，再 DeepSeek 画像抽取 + TTS 回复。
# 默认关闭；生产启用需满足三道门禁 + AccessKey 配置。
# 实时 ASR 鉴权需要 AccessKey ID/Secret（换取 NLS Token），与 REST 模式的
# api_key/app_key 不同：凭据仅存于被忽略的 .env，不进 .env.example。
#   AI_ALIYUN_VOICE_ACCESS_KEY_ID=<your_access_key_id>
#   AI_ALIYUN_VOICE_ACCESS_KEY_SECRET=<your_access_key_secret>
AI_VOICE_CONVERSATION_ENABLED=false
AI_VOICE_CONVERSATION_MAX_TURN_SECONDS=60
AI_ALIYUN_VOICE_ASR_WS_URL=wss://nls-gateway.cn-shanghai.aliyuncs.com/ws/v1

# ==================== AI 军师（产品口径冻结后调整） ====================
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# AI_API_KEY=YOUR_AI_API_KEY
AI_DAILY_ADVISOR_LIMIT=20
AI_ADVISOR_MAX_CONTEXT_MESSAGES=80
AI_ADVISOR_PROMPT_VERSION=relationship-v1
AI_ADVISOR_KNOWLEDGE_VERSION=seed-v1
